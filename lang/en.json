{
    "BAD": {
        "settings": {
            "hudOpacity": {
                "name": "HUD Opacity",
                "hint": "Controls the transparency of the Action Display HUD overlay."
            },
            "hudScale": {
                "name": "HUD Scale",
                "hint": "Controls the overall scale of the HUD window and all its contents proportionally."
            },
            "fontSize": {
                "name": "Font Size (px)",
                "hint": "Controls the base font size of the text and icons. The HUD window size will remain independent."
            },
            "logVerbosity": {
                "name": "Log Verbosity Level",
                "hint": "Controls the level of detail printed to the browser console.",
                "choices": {
                    "error": "Errors Only",
                    "warn": "Warnings & Errors (Default)",
                    "info": "Info, Warnings & Errors",
                    "debug": "Debug (Everything)"
                }
            },
            "persistDetached": {
                "name": "Persist Detached HUD on Click-Off",
                "hint": "If enabled, a detached HUD will stay open when clicking off the token, and will only close if you right-click the same token again."
            },
            "hudPositionPreference": {
                "name": "HUD Placement Preference Order",
                "hint": "Controls the order of preferred sides around the token where the HUD will attempt to attach.",
                "choices": {
                    "top-bottom-left-right": "Top → Bottom → Left → Right",
                    "bottom-top-right-left": "Bottom → Top → Right → Left",
                    "left-right-top-bottom": "Left → Right → Top → Bottom",
                    "right-left-bottom-top": "Right → Left → Bottom → Top",
                    "top-bottom-right-left": "Top → Bottom → Right → Left",
                    "bottom-top-left-right": "Bottom → Top → Left → Right"
                }
            }
        },
